#!/usr/bin/env python3
"""Test-only busctl fallback sharing the gdbus UPower fixture."""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path


def main() -> int:
    arguments = [arg for arg in sys.argv[1:] if not arg.startswith("--")]
    if arguments != ["get-property", "org.freedesktop.UPower", "/org/freedesktop/UPower",
                     "org.freedesktop.UPower", "OnBattery"]:
        return 1
    path = Path(os.environ.get("SPAREHASH_UPOWER_FIXTURE", "/run/sparehash-qa/upower.json"))
    data = json.loads(path.read_text(encoding="ascii"))
    if data.get("available", True) is not True:
        return 1
    value = data["org.freedesktop.UPower"]["OnBattery"]
    if type(value) is not bool:
        return 1
    print("b true" if value else "b false")
    return 0


if __name__ == "__main__":
    sys.exit(main())
