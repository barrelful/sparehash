#!/usr/bin/env python3
"""gamemoded shim for QA testing.

Emulates the two upstream responses the controller accepts and nothing else:

    gamemoded -s  ->  "gamemode is active" | "gamemode is inactive"  (exit 0)

Observation note: the controller never consults PATH. It resolves the helper
with `shutil.which(name, path=FIXED_PATH)` and then refuses any executable
whose resolved path or any parent is not root-owned and free of group/world
write bits. The shim is therefore only observed once it is installed at a
root-owned fixed location such as /usr/bin/gamemoded (the QA runtime bind-mounts
a root-owned 0755 copy of this file there inside the controller namespace);
running it from the repository or from /tmp is a self-test, not an observation.

State lives in a single root-only document. Because the shim may execute from
the bind-mounted location (/usr/bin/gamemoded), the default fixture path is
fixed and independent of __file__:

    /run/sparehash-qa/gamemoded.json

SPAREHASH_QA_GAMEMODE_FIXTURE overrides the default for local self-tests, and
--fixture overrides both. The controller's query environment is a fixed dict
(PATH and LC_ALL only), so the in-namespace observation always uses the fixed
default. A missing fixture means "inactive", never an error. Writes are atomic
and root-only (0600) so a concurrent reader never observes a partial document
and the document is never readable by non-root.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path
from typing import Final

DEFAULT_FIXTURE: Final = Path("/run/sparehash-qa/gamemoded.json")
INACTIVE: Final = {"active": False, "status": "gamemode is inactive"}
ACTIVE: Final = {"active": True, "status": "gamemode is active"}


class ShimError(RuntimeError):
    """A fixture problem with a stable message."""


def fixture_path() -> Path:
    """Fixed runtime default, overridable only outside the controller query."""
    override = os.environ.get("SPAREHASH_QA_GAMEMODE_FIXTURE")
    return Path(override) if override else DEFAULT_FIXTURE


def load_fixture(path: Path) -> dict:
    """Read the fixture, falling back to a fresh inactive document."""
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return dict(INACTIVE)
    except (OSError, json.JSONDecodeError) as error:
        raise ShimError(f"cannot read fixture {path}: {error}") from error
    if not isinstance(document, dict):
        raise ShimError(f"fixture {path} must be a JSON object")
    return document


def write_fixture(path: Path, document: dict) -> None:
    """Replace the fixture atomically, root-only, so readers never see a tear."""
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        with temporary.open("w", encoding="utf-8") as sink:
            json.dump(document, sink, indent=2, sort_keys=True)
            sink.write("\n")
            sink.flush()
            os.fsync(sink.fileno())
        os.chmod(temporary, 0o600)
        if os.geteuid() == 0:
            os.chown(temporary, 0, 0)
        os.replace(temporary, path)
    except OSError as error:
        temporary.unlink(missing_ok=True)
        raise ShimError(f"cannot write fixture {path}: {error}") from error


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="gamemoded", description="gamemoded QA shim")
    parser.add_argument("-s", "--status", action="store_true",
                        help="report the current session state and exit (the only form the controller uses)")
    parser.add_argument("--fixture", type=str, default=None,
                        help="fixture document to read (default: /run/sparehash-qa/gamemoded.json)")
    parser.add_argument("--set-active", action="store_true", help="record an active session")
    parser.add_argument("--set-inactive", action="store_true", help="record an inactive session")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    path = Path(args.fixture) if args.fixture else fixture_path()
    try:
        if args.set_active and args.set_inactive:
            raise ShimError("--set-active and --set-inactive are mutually exclusive")
        if args.set_active or args.set_inactive:
            target = ACTIVE if args.set_active else INACTIVE
            write_fixture(path, dict(target))
        if args.status or not (args.set_active or args.set_inactive):
            document = load_fixture(path)
            active = document.get("active")
            if active is True:
                print(ACTIVE["status"])
            elif active is False:
                print(INACTIVE["status"])
            else:
                raise ShimError(f"fixture {path} must carry a boolean 'active'")
    except ShimError as error:
        print(f"gamemoded: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
