#!/usr/bin/env python3
"""Test-only UPower helper. Fixture changes produce live monitor signals."""

from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path
from typing import Final

FIXTURE: Final = Path(os.environ.get("SPAREHASH_UPOWER_FIXTURE", "/run/sparehash-qa/upower.json"))


def main() -> int:
    arguments = sys.argv[1:]
    if not arguments:
        return 1
    # No defaults: missing/malformed fixtures must fail rather than invent power.
    data = json.loads(FIXTURE.read_text(encoding="ascii"))
    if data.get("available", True) is not True:
        return 1
    if arguments[0] == "monitor":
        previous = FIXTURE.read_bytes()
        print("Monitoring org.freedesktop.UPower", flush=True)
        while True:
            time.sleep(0.02)
            current = FIXTURE.read_bytes()
            if current != previous:
                data = json.loads(current)
                if data.get("available", True) is not True:
                    return 1
                print("/org/freedesktop/UPower: org.freedesktop.DBus.Properties.PropertiesChanged "
                      "('org.freedesktop.UPower', {}, [])", flush=True)
                previous = current
    if arguments[0] != "call" or "--method" not in arguments:
        return 1
    method_index = arguments.index("--method") + 1
    method = arguments[method_index]
    props = data["org.freedesktop.UPower"]
    value = props["OnBattery"]
    if type(value) is not bool:
        return 1
    boolean = "true" if value else "false"
    if method == "org.freedesktop.DBus.Properties.GetAll":
        print(f"({{'OnBattery': <{boolean}>}},)")
        return 0
    if method == "org.freedesktop.DBus.Properties.Get" and arguments[-1] == "OnBattery":
        print(f"(<{boolean}>,)")
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main())
